# Deployment Mode — which Docker Compose profile to activate.
# Options: standalone (default), edge (Pi only), server (remote only)
# Helper scripts (scripts/start.sh, scripts/stop.sh) read this value.
DEPLOY_MODE=standalone

# MQTT Configuration
# In standalone mode, Telegraf connects to the local Mosquitto container (default).
# In server mode, set MQTT_HOST to the Pi's IP address or hostname.
MQTT_HOST=mosquitto
MQTT_PORT=1883
# MQTT credentials — leave empty for anonymous (standalone default).
# Required for split mode with password-protected Mosquitto.
# MQTT_USER=telegraf
# MQTT_PASSWORD=change-me

# InfluxDB Configuration
INFLUXDB_ORG=pool
INFLUXDB_BUCKET=pool_temps
INFLUXDB_TOKEN=change-me
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=change-me

# Sensor IDs — Telegraf filters MQTT data to only keep readings from these sensors.
# The value is inserted into a TOML array in telegraf.conf: id = ["${INKBIRD_SENSOR_IDS}"]
# Do NOT quote the values — the outer quotes are already in the TOML config.
#
# Find your sensor ID by checking rtl_433 logs: docker logs rtl_433
# Look for the "id" field in the JSON output.
#
# Single sensor:
#   INKBIRD_SENSOR_IDS=29908
#
# Multiple sensors (the ", " closes and reopens TOML string quotes to form an array):
#   INKBIRD_SENSOR_IDS=29908", "67890
#   This expands to: id = ["29908", "67890"] in telegraf.conf
INKBIRD_SENSOR_IDS=00000

# Grafana
GRAFANA_ADMIN_PASSWORD=change-me

# Cloudflare Tunnel — create a tunnel in the Zero Trust dashboard and paste the token here.
# Set the tunnel's public hostname pointing to http://pool-dashboard:8080
CLOUDFLARE_TUNNEL_TOKEN=change-me

# Dashboard — custom title shown in the header (default: "Pool Dashboard")
# DASHBOARD_TITLE=Pool Dashboard

# Public URL for Open Graph image previews (used in iMessage, Slack, etc.)
# Set this to your Cloudflare Tunnel URL or public domain.
# If unset, falls back to the request's Host header.
# PUBLIC_URL=https://pool.yourdomain.com

# Timezone for OG image timestamp and server-side dates (IANA format, default: America/New_York)
# Also sets TZ in the container so season stats use the correct local year.
# TIMEZONE=America/New_York
