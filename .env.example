# InfluxDB Configuration
INFLUXDB_ORG=pool
INFLUXDB_BUCKET=pool_temps
INFLUXDB_TOKEN=change-me
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=change-me

# Sensor IDs — each value must be individually quoted because Telegraf
# substitutes this directly into a TOML array: id = [${INKBIRD_SENSOR_IDS}]
# Single: INKBIRD_SENSOR_IDS="12345"
# Multiple: INKBIRD_SENSOR_IDS="12345", "67890"
INKBIRD_SENSOR_IDS="00000"

# Grafana
GRAFANA_ADMIN_PASSWORD=change-me
