# Deployment Mode — which Docker Compose profile to activate.
# Options: standalone (default), edge (Pi only), server (remote only)
# Helper scripts (scripts/start.sh, scripts/stop.sh) read this value.
DEPLOY_MODE=standalone

# MQTT Configuration
# In standalone mode, Telegraf connects to the local Mosquitto container (default).
# In server mode, set MQTT_HOST to the Pi's IP address or hostname.
MQTT_HOST=mosquitto
MQTT_PORT=1883
# MQTT credentials — leave empty for anonymous (standalone default).
# Required for split mode with password-protected Mosquitto.
# MQTT_USER=telegraf
# MQTT_PASSWORD=change-me

# InfluxDB Configuration
INFLUXDB_ORG=pool
INFLUXDB_BUCKET=pool_temps
INFLUXDB_TOKEN=change-me
# NOTE: this is the InfluxDB *admin* (operator) token — it bootstraps the
# instance (DOCKER_INFLUXDB_INIT_ADMIN_TOKEN) and is currently reused by every
# service (telegraf, dashboard, weather, grafana). The dashboard needs WRITE
# scope (it logs chemistry readings), not just read.
# HARDENING (recommended): after first boot, create a token in the InfluxDB UI
# scoped to read+write on the `pool_temps` bucket only, and set that as the
# token for the dashboard/weather/telegraf/grafana services. Keep the operator
# token out of the long-running app containers; rotate it once scoped tokens
# are in place. See docs/deployment.md.
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=change-me

# Sensor IDs — Telegraf only keeps readings from these sensors; anything else
# is dropped (so a wrong ID means nothing is recorded). Leave empty to keep all.
#
# Find your sensor ID by checking rtl_433 logs: docker logs rtl_433
# Look for the "id" field in the JSON output.
#
# Single sensor:
#   INKBIRD_SENSOR_IDS=12345
#
# Multiple sensors, comma-separated:
#   INKBIRD_SENSOR_IDS=12345,67890
# (The older form 12345", "67890 is still accepted.)
INKBIRD_SENSOR_IDS=00000

# Off-season mode — set to true once the pool closes for the year.
# Stops recording pool sensor readings (Telegraf drops them) and pauses the
# weather poller, so the database stops growing over the winter. Logging
# chemistry, swims and events still works, and existing data is kept.
# The dashboard opens on the Season tab and notes that recording is paused.
# Set back to false in spring. Apply with: ./scripts/start.sh
# (recreates the affected containers with the new value).
OFF_SEASON=false

# Grafana
GRAFANA_ADMIN_PASSWORD=change-me

# Cloudflare Tunnel — create a tunnel in the Zero Trust dashboard and paste the token here.
# Set the tunnel's public hostname pointing to http://pool-dashboard:8080
CLOUDFLARE_TUNNEL_TOKEN=change-me

# Dashboard — custom title shown in the header (default: "Pool Dashboard")
# DASHBOARD_TITLE=Pool Dashboard

# Public URL for Open Graph image previews (used in iMessage, Slack, etc.)
# Set this to your Cloudflare Tunnel URL or public domain.
# If unset, falls back to the request's Host header.
# PUBLIC_URL=https://pool.yourdomain.com

# Timezone for OG image timestamp and server-side dates (IANA format, default: America/New_York)
# Also sets TZ in the container so season stats use the correct local year.
# TIMEZONE=America/New_York

# --- Chemistry logging (write auth) ---
# Single shared credential that gates POST /api/chemistry (the log-test form).
# The rest of the dashboard stays public/read-only.
CHEM_AUTH_USER=pooladmin
CHEM_AUTH_PASSWORD=change-me

# --- Weather sidecar (optional) ---
# Get a free API key at https://www.weatherapi.com/
# Leave WEATHERAPI_KEY empty to disable the weather sidecar.
WEATHERAPI_KEY=
# Prefer a zip code or "City, State, Country" — bare city names are ambiguous
# (e.g. "Cheltenham, PA" resolves to Cheltenham, England).
WEATHER_LOCATION=19012
# WEATHER_INTERVAL_MINUTES=30
