# InfluxDB Configuration
INFLUXDB_ORG=pool
INFLUXDB_BUCKET=pool_temps
INFLUXDB_TOKEN=change-me
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=change-me

# Sensor IDs — do NOT quote the values here; the TOML quotes are in telegraf.conf.
# Single sensor:
#   INKBIRD_SENSOR_IDS=12345
# Multiple sensors (include inner TOML quotes for the array):
#   INKBIRD_SENSOR_IDS=12345", "67890
INKBIRD_SENSOR_IDS=00000

# Grafana
GRAFANA_ADMIN_PASSWORD=change-me
