{
  "name": "pool-monitor-weather",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@influxdata/influxdb-client": "^1.35.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "overrides": {
      "vite": "^7.0.0",
      "postcss": ">=8.5.10"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
